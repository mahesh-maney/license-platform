{
  "type": "record",
  "name": "SubscriptionEvent",
  "namespace": "com.modus.license.events.subscription",
  "doc": "Lifecycle events for a tenant subscription. Topic: modus.subscription.events. Key: subscriptionId.",
  "fields": [
    {
      "name": "metadata",
      "type": "com.modus.license.events.common.EventMetadata"
    },
    {
      "name": "subscriptionId",
      "type": "string",
      "doc": "UUID of the subscription."
    },
    {
      "name": "tenantId",
      "type": "string"
    },
    {
      "name": "planId",
      "type": "string",
      "doc": "UUID of the subscription plan."
    },
    {
      "name": "planTier",
      "type": "string",
      "doc": "PlanTier: FREE | STARTER | PROFESSIONAL | ENTERPRISE | CUSTOM."
    },
    {
      "name": "licenseType",
      "type": "string",
      "doc": "LicenseType: NAMED_USER | CONCURRENT | SITE | METERED_SUBSCRIPTION."
    },
    {
      "name": "seatLimit",
      "type": ["null", "int"],
      "default": null,
      "doc": "Max seats/concurrent users. Null = unlimited (SITE licence)."
    },
    {
      "name": "billingCycle",
      "type": "string",
      "doc": "MONTHLY | ANNUAL | CUSTOM."
    },
    {
      "name": "startDate",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Subscription start timestamp."
    },
    {
      "name": "endDate",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Subscription end timestamp. Null = no fixed end (evergreen)."
    },
    {
      "name": "previousPlanId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Plan UUID before this change, present on UPGRADED/DOWNGRADED events."
    },
    {
      "name": "previousPlanTier",
      "type": ["null", "string"],
      "default": null,
      "doc": "PlanTier before this change."
    },
    {
      "name": "cancellationReason",
      "type": ["null", "string"],
      "default": null,
      "doc": "Reason provided on SUBSCRIPTION_CANCELLED events."
    },
    {
      "name": "effectiveAt",
      "type": {"type": "long", "logicalType": "timestamp-millis"}
    }
  ]
}
