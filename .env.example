# ============================================================
# MODUS LICENSE PLATFORM — Environment Variable Reference
# ============================================================
# Copy this file to .env for local development.
# In production (AKS), these are injected via Azure Key Vault
# references in Azure App Configuration or K8s Secrets.
# NEVER commit a populated .env file.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_VERSION=1.0.0-SNAPSHOT
APP_ENV=local                          # local | dev | staging | prod
LOG_LEVEL=INFO                         # TRACE | DEBUG | INFO | WARN | ERROR

# ------------------------------------------------------------
# KEYCLOAK (local dev — admin console at http://localhost:8180)
# ------------------------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=admin

# ------------------------------------------------------------
# GRAFANA (local dev — UI at http://localhost:3000)
# ------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------
# AZURE — Identity & Container Registry
# ------------------------------------------------------------
AZURE_TENANT_ID=<your-azure-tenant-id>
AZURE_CLIENT_ID=<your-managed-identity-client-id>
# For local dev only (use Managed Identity in AKS):
AZURE_CLIENT_SECRET=<your-client-secret>

CONTAINER_REGISTRY=modusacr.azurecr.io

# ------------------------------------------------------------
# AZURE KEY VAULT
# ------------------------------------------------------------
AZURE_KEYVAULT_URI=https://modus-kv.vault.azure.net/
# All secrets below can optionally be fetched from Key Vault
# by setting AZURE_KEYVAULT_URI and using @AzureKeyVaultSecretAnnotation

# ------------------------------------------------------------
# AZURE APP CONFIGURATION (centralised config in prod)
# ------------------------------------------------------------
AZURE_APPCONFIGURATION_ENDPOINT=https://modus-appconfig.azconfig.io
AZURE_APPCONFIGURATION_LABEL=prod       # prod | staging | dev

# ------------------------------------------------------------
# DATABASE — PostgreSQL (Azure Database for PostgreSQL Flexible)
# ------------------------------------------------------------
# Tenant Management
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_NAME=modus_tenant
TENANT_DB_USERNAME=modus_tenant_user
TENANT_DB_PASSWORD=changeme
TENANT_DB_POOL_SIZE=20
TENANT_DB_MAX_IDLE=10
TENANT_DB_CONN_TIMEOUT_MS=30000

# Subscription & Plan
SUBSCRIPTION_DB_HOST=localhost
SUBSCRIPTION_DB_PORT=5432
SUBSCRIPTION_DB_NAME=modus_subscription
SUBSCRIPTION_DB_USERNAME=modus_sub_user
SUBSCRIPTION_DB_PASSWORD=changeme
SUBSCRIPTION_DB_POOL_SIZE=20

# Entitlement
ENTITLEMENT_DB_HOST=localhost
ENTITLEMENT_DB_PORT=5432
ENTITLEMENT_DB_NAME=modus_entitlement
ENTITLEMENT_DB_USERNAME=modus_ent_user
ENTITLEMENT_DB_PASSWORD=changeme
ENTITLEMENT_DB_POOL_SIZE=20

# Feature Control
FEATURE_DB_HOST=localhost
FEATURE_DB_PORT=5432
FEATURE_DB_NAME=modus_feature
FEATURE_DB_USERNAME=modus_feat_user
FEATURE_DB_PASSWORD=changeme
FEATURE_DB_POOL_SIZE=10

# Named-User License
NAMED_LICENSE_DB_HOST=localhost
NAMED_LICENSE_DB_PORT=5432
NAMED_LICENSE_DB_NAME=modus_named_license
NAMED_LICENSE_DB_USERNAME=modus_nl_user
NAMED_LICENSE_DB_PASSWORD=changeme
NAMED_LICENSE_DB_POOL_SIZE=10

# User Management
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=modus_user
USER_DB_USERNAME=modus_user_svc
USER_DB_PASSWORD=changeme
USER_DB_POOL_SIZE=20

# Audit
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=modus_audit
AUDIT_DB_USERNAME=modus_audit_user
AUDIT_DB_PASSWORD=changeme
AUDIT_DB_POOL_SIZE=10

# Reporting
REPORTING_DB_HOST=localhost
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=modus_reporting
REPORTING_DB_USERNAME=modus_report_user
REPORTING_DB_PASSWORD=changeme
REPORTING_DB_POOL_SIZE=10

# Notification
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=modus_notification
NOTIFICATION_DB_USERNAME=modus_notif_user
NOTIFICATION_DB_PASSWORD=changeme
NOTIFICATION_DB_POOL_SIZE=10

# Flyway migration (each service runs its own migrations)
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ------------------------------------------------------------
# REDIS — Azure Cache for Redis
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_SSL_ENABLED=false          # true in prod (Azure Cache for Redis uses SSL)
REDIS_DATABASE=0
REDIS_TIMEOUT_MS=2000
REDIS_POOL_MAX_ACTIVE=50
REDIS_POOL_MAX_IDLE=20
REDIS_POOL_MIN_IDLE=5

# Entitlement cache TTL
ENTITLEMENT_CACHE_TTL_SECONDS=300

# Session TTL (concurrent sessions)
SESSION_TTL_SECONDS=3600
SESSION_HEARTBEAT_INTERVAL_SECONDS=60

# ------------------------------------------------------------
# KAFKA — Azure Event Hubs (Kafka protocol compatible)
# In local dev, points to local Kafka container
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT      # SASL_SSL in prod (Azure Event Hubs)
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SCHEMA_REGISTRY_USERNAME=
KAFKA_SCHEMA_REGISTRY_PASSWORD=

# Producer
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_BATCH_SIZE=16384
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_COMPRESSION_TYPE=lz4

# Consumer
KAFKA_CONSUMER_GROUP_PREFIX=modus
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_MAX_POLL_RECORDS=500
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false

# Topic names (override per environment)
KAFKA_TOPIC_TENANT_EVENTS=modus.tenant.events
KAFKA_TOPIC_SUBSCRIPTION_EVENTS=modus.subscription.events
KAFKA_TOPIC_ENTITLEMENT_EVENTS=modus.entitlement.events
KAFKA_TOPIC_FEATURE_EVENTS=modus.feature.events
KAFKA_TOPIC_SESSION_EVENTS=modus.session.events
KAFKA_TOPIC_ENFORCEMENT_DECISIONS=modus.enforcement.decisions
KAFKA_TOPIC_NAMED_LICENSE_EVENTS=modus.named-license.events
KAFKA_TOPIC_USER_EVENTS=modus.user.events
KAFKA_TOPIC_USAGE_EVENTS=modus.usage.events
KAFKA_TOPIC_AUDIT_EVENTS=modus.audit.events
KAFKA_TOPIC_NOTIFICATION_EVENTS=modus.notification.events
KAFKA_TOPIC_BILLING_EVENTS=modus.billing.events
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION_FACTOR=3     # 1 for local dev

# ------------------------------------------------------------
# IAM — Keycloak (or Azure AD / Entra ID)
# ------------------------------------------------------------
IAM_ISSUER_URI=http://localhost:8180/realms/modus
IAM_JWK_SET_URI=http://localhost:8180/realms/modus/protocol/openid-connect/certs
IAM_TOKEN_ENDPOINT=http://localhost:8180/realms/modus/protocol/openid-connect/token
IAM_AUDIENCE=modus-license-api
IAM_REALM=modus

# Service-to-service client credentials (each service has its own)
IAM_CLIENT_ID_GATEWAY=modus-gateway
IAM_CLIENT_SECRET_GATEWAY=changeme
IAM_CLIENT_ID_ENFORCEMENT=modus-enforcement
IAM_CLIENT_SECRET_ENFORCEMENT=changeme

# Token validation
JWT_CLAIM_TENANT_ID=tenant_id
JWT_CLAIM_ROLES=roles
JWT_CLAIM_USER_ID=sub
JWT_TOKEN_EXPIRY_SECONDS=900         # 15 min
JWT_REFRESH_EXPIRY_SECONDS=86400     # 24 hr

# ------------------------------------------------------------
# gRPC — Internal service communication (hot path)
# ------------------------------------------------------------
GRPC_SESSION_HOST=session
GRPC_SESSION_PORT=9097
GRPC_SESSION_DEADLINE_MS=50

GRPC_ENFORCEMENT_HOST=enforcement-engine
GRPC_ENFORCEMENT_PORT=9098
GRPC_ENFORCEMENT_DEADLINE_MS=150

GRPC_TLS_ENABLED=false               # true in prod (mTLS via Istio)

# ------------------------------------------------------------
# SERVICE PORTS (HTTP)
# ------------------------------------------------------------
PORT_API_GATEWAY=8080
PORT_TENANT_MANAGEMENT=8081
PORT_SUBSCRIPTION_PLAN=8082
PORT_ENTITLEMENT=8083
PORT_FEATURE_CONTROL=8084
PORT_NAMED_USER_LICENSE=8085
PORT_USER_MANAGEMENT=8086
PORT_SESSION=8087
PORT_ENFORCEMENT_ENGINE=8088
PORT_USAGE_METERING=8089
PORT_REPORTING_ANALYTICS=8090
PORT_NOTIFICATION=8091
PORT_AUDIT=8092
PORT_SCHEDULER_WORKFLOW=8093

# Service-to-service hostnames
# Local bootRun: leave as localhost (all services on same machine)
# Docker / K8s:  set to container/pod service names (handled by docker-compose)
TENANT_MANAGEMENT_HOST=localhost
SUBSCRIPTION_PLAN_HOST=localhost
ENTITLEMENT_HOST=localhost
FEATURE_CONTROL_HOST=localhost
NAMED_USER_LICENSE_HOST=localhost
USER_MANAGEMENT_HOST=localhost
SESSION_HOST=localhost
ENFORCEMENT_ENGINE_HOST=localhost
USAGE_METERING_HOST=localhost
REPORTING_ANALYTICS_HOST=localhost
NOTIFICATION_HOST=localhost
AUDIT_HOST=localhost
SCHEDULER_WORKFLOW_HOST=localhost

# ------------------------------------------------------------
# API GATEWAY
# ------------------------------------------------------------
GATEWAY_RATE_LIMIT_REPLENISH_RATE=100    # requests per second per client
GATEWAY_RATE_LIMIT_BURST_CAPACITY=200
GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
GATEWAY_CORS_MAX_AGE_SECONDS=3600

# Circuit breaker
CB_SLIDING_WINDOW_SIZE=10
CB_FAILURE_RATE_THRESHOLD=50
CB_WAIT_DURATION_IN_OPEN_STATE_SECONDS=30
CB_PERMITTED_CALLS_IN_HALF_OPEN_STATE=5

# ------------------------------------------------------------
# ENFORCEMENT ENGINE
# ------------------------------------------------------------
ENFORCEMENT_CACHE_WARM_ON_STARTUP=true
ENFORCEMENT_DECISION_TIMEOUT_MS=200          # hard SLA
ENFORCEMENT_CACHE_MISS_FALLBACK_DB=true      # fallback to DB if cache miss

# ------------------------------------------------------------
# SESSION SERVICE
# ------------------------------------------------------------
SESSION_MAX_CONCURRENT_DEFAULT=50            # default pool if not set by entitlement
SESSION_CLEANUP_INTERVAL_SECONDS=30          # reclaim expired sessions

# ------------------------------------------------------------
# NOTIFICATION
# ------------------------------------------------------------
NOTIFICATION_EMAIL_HOST=smtp.office365.com
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USERNAME=noreply@modus.com
NOTIFICATION_EMAIL_PASSWORD=changeme
NOTIFICATION_EMAIL_FROM=noreply@modus.com
NOTIFICATION_EMAIL_TLS_ENABLED=true

NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
NOTIFICATION_WEBHOOK_RETRY_MAX=3
NOTIFICATION_WEBHOOK_RETRY_DELAY_MS=1000

# Renewal warning lead time
NOTIFICATION_RENEWAL_WARN_DAYS=30,14,7,1

# ------------------------------------------------------------
# SCHEDULER / WORKFLOW — Temporal.io
# ------------------------------------------------------------
TEMPORAL_SERVICE_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=modus-license
TEMPORAL_TASK_QUEUE=modus-license-tasks
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOWS=50

# Renewal/expiry job schedule (CRON expression)
SCHEDULER_RENEWAL_SWEEP_CRON=0 0 * * *      # daily midnight
SCHEDULER_EXPIRY_SWEEP_CRON=0 * * * *       # hourly
SCHEDULER_GRACE_PERIOD_DAYS=7

# ------------------------------------------------------------
# AUDIT
# ------------------------------------------------------------
AUDIT_HASH_ALGORITHM=SHA-256
AUDIT_WORM_ENABLED=true

# Azure Blob Storage for WORM (immutable storage)
AZURE_STORAGE_ACCOUNT_NAME=modusauditstorage
AZURE_STORAGE_CONTAINER_NAME=audit-worm          # used by audit service
AZURE_REPORTING_CONTAINER_NAME=license-reports   # used by reporting-analytics service
AZURE_STORAGE_ENDPOINT=https://modusauditstorage.blob.core.windows.net

# SIEM egress (Azure Sentinel / Splunk webhook)
AUDIT_SIEM_ENABLED=false
AUDIT_SIEM_ENDPOINT=
AUDIT_SIEM_API_KEY=

# Legal hold retention days
AUDIT_RETENTION_DAYS=2555              # 7 years

# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------
MANAGEMENT_ENDPOINTS_ENABLED=health,info,metrics,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=when-authorized

# Distributed tracing (Zipkin / Azure Application Insights)
TRACING_ENABLED=true
TRACING_ENDPOINT=http://localhost:9411/api/v2/spans
TRACING_SAMPLE_RATE=1.0              # 1.0=100% for dev, 0.1 for prod

# Azure Application Insights (prod)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Prometheus scrape port (all services expose /actuator/prometheus)
METRICS_PROMETHEUS_ENABLED=true

# ------------------------------------------------------------
# MULTI-REGION / DATA RESIDENCY
# ------------------------------------------------------------
PLATFORM_REGION=eastus               # Azure region identifier
PLATFORM_HOME_REGION=eastus          # tenant pinning default
PLATFORM_DR_REGION=westus2           # paired DR region

# ------------------------------------------------------------
# FEATURE FLAGS (platform-level)
# ------------------------------------------------------------
FEATURE_USAGE_BASED_BILLING_ENABLED=false
FEATURE_MSSP_LICENSING_ENABLED=false
FEATURE_MARKETPLACE_ENABLED=false
FEATURE_AI_TOKEN_LICENSING_ENABLED=false
